<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\IAdetector.Core\IAdetector.Core.csproj" />
    <ProjectReference Include="..\IAdetector.Infrastructure\IAdetector.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Empaquetable como dotnet tool global (dotnet tool install -g IAdetector.Cli) -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>iadetector</ToolCommandName>

    <!-- Self-contained + single-file: además de "dotnet tool", también publicable como binario
         nativo standalone (dotnet publish -r <rid> -p:PublishAot=true) sin runtime .NET instalado. -->
    <SelfContained>true</SelfContained>
    <PublishSelfContained>true</PublishSelfContained>
    <PublishSingleFile>true</PublishSingleFile>

    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>IAdetector.Cli</PackageId>
    <PackageVersion>0.1.0-beta</PackageVersion>
    <PackageTags>ai-detection; cli; text-analysis</PackageTags>
    <Description>CLI para detectar texto generado por IA, 100% local (sin llamar a ninguna API externa).</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
